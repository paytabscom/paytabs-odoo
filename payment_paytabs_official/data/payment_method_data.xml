<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The payment methods available depend on the region and on the PayTabs profile; card is
         common to all. See https://site.paytabs.com/en/payment-methods/ -->

    <!-- === PRIMARY PAYMENT METHODS === -->

    <record id="payment_method_aman" model="payment.method">
        <field name="name">Aman</field>
        <field name="code">aman</field>
        <field name="provider_id" ref="payment_paytabs_official.payment_provider_paytabs"/>
        <field name="image" type="bytes" file="payment/static/img/aman.png"/>
        <field name="support_refund">partial</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.eg')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.EGP')])]"/>
    </record>

    <record id="payment_method_card" model="payment.method">
        <field name="name">Card</field>
